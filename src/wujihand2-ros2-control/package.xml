<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wujihand2_ros2_control</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Control hardware interface for Wuji Hand 2 (Ethernet / wuji-sdk C API).
  </description>

  <maintainer email="dev@fiveages.local">fiveages</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_common_launch</exec_depend>
  <exec_depend>basic_joint_controller</exec_depend>
  <exec_depend>wuji_description</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/wujihand2_ros2_control.xml"/>
  </export>
</package>
