# ROS2 build directories
build/
install/
log/
docs/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
# Track vendored Wuji C SDK prebuilts (x86_64 + aarch64)
!src/wujihand2-ros2-control/external/wuji-sdk-c/lib/**/*.so

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.codex

# quick_start 本地扫描工具缓存
.cache/

# deb 安装脚本下载缓存（install_core_debs.sh）
.deb_cache/

# init_repo.sh 记录的模块 source/deb 选择
.core_module_mode

# 本机 Hand2 网络配置（由 hand.local.template.conf 复制）
config/hand.local.conf
# quick_start 上次启动记录（对齐 fa_w2_ws）
config/launch_last.conf
